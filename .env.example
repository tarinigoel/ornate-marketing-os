# --- Database ---
# Leave empty locally to use PGlite (stored in ./.data/pglite). Set to a Neon URL in production.
DATABASE_URL=

# --- Auth.js ---
AUTH_SECRET=change-me-run-npx-auth-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only these Google accounts can sign in
ALLOWED_DOMAIN=ornatesolar.com
# Extra individual addresses allowed (comma separated), optional
ALLOWED_EMAILS=
# Who is the Head (comma separated)
HEAD_EMAILS=fateh@ornatesolar.com
# Local only: show a "dev sign-in" box (never active in production)
AUTH_DEV_LOGIN=false

# --- AI ---
GROQ_API_KEY=

# --- Cron ---
CRON_SECRET=change-me

# --- Reporting ---
INSTINCT_WEBHOOK_URL=
RESEND_API_KEY=
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=
